[Unit]
Description=Open436 relay origin health guard
After=network-online.target open436-frps.service nginx.service open436-cloudflared.service
Wants=network-online.target open436-frps.service nginx.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/open436-relay-health-guard
Restart=always
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
