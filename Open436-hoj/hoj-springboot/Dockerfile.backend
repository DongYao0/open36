# ── HOJ Backend ── 多阶段构建 (Java 8)
FROM maven:3.8-eclipse-temurin-8 AS builder
WORKDIR /build
COPY pom.xml .
COPY api/pom.xml api/pom.xml
COPY DataBackup/pom.xml DataBackup/pom.xml
COPY JudgeServer/pom.xml JudgeServer/pom.xml
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn package -DskipTests -B -pl DataBackup -am

FROM eclipse-temurin:8-jre-jammy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/DataBackup/target/*.jar app.jar
EXPOSE 6688
ENTRYPOINT ["java", "-jar", "app.jar"]
