map $http_upgrade $open436_connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $open436_forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

# The direct IP ingress keeps ordinary HTTP/1.1 connections reusable.  The
# older domain ingress map below intentionally retains its existing behavior.
map $http_upgrade $open436_ip_connection_upgrade {
    default upgrade;
    '' '';
}

upstream open436_ip_public_web {
    # Keep both independently registered tunnels active.  Passive removal of
    # either one would otherwise create a "no live upstreams" gap during FRP
    # re-registration.
    server 127.0.0.1:18080 max_fails=0;
    server 127.0.0.1:18082 max_fails=0;
    server 127.0.0.1:18083 max_fails=0;
    keepalive 128;
}

server {
    listen 80;
    listen [::]:80;
    server_name 47.104.67.179;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://47.104.67.179$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 47.104.67.179;

    ssl_certificate /etc/letsencrypt/live/47.104.67.179/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/47.104.67.179/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:Open436TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 2g;
    keepalive_timeout 75s;

    # Secondary FRP control path: HTTPS/WSS on the standard web port avoids
    # coupling the standby tunnel to the long-lived raw TCP/7000 path.
    location = /~!frp {
        proxy_pass http://127.0.0.1:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://open436_ip_public_web;
        proxy_http_version 1.1;
        proxy_set_header Host open0436.space;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $open436_ip_connection_upgrade;
        proxy_connect_timeout 3s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_socket_keepalive on;
        proxy_request_buffering off;
        proxy_buffering off;
        # GET/HEAD may fail over to the standby tunnel. Nginx does not replay
        # non-idempotent writes unless explicitly configured to do so.
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        # There are three relay transports. A request may select both failed
        # TCP peers before reaching the WSS peer, so allow all three attempts.
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 10s;
    }
}

# Domain traffic is intentionally retained as a separate ingress path.
server {
    listen 80;
    listen [::]:80;
    server_name open0436.space www.open0436.space relay.open0436.space;
    client_max_body_size 2g;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $open436_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $open436_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name openadmin.open0436.space;
    client_max_body_size 2g;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $open436_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $open436_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
