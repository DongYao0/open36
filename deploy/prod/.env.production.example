# ══════════════════════════════════════════════════════════
#  Open436 生产部署环境变量模板
#  复制为 deploy/prod/.env.production 并填写真实值。
#  注意：本文件仅提交模板；真实 .env.production 不得入库（见 .gitignore）。
#
#  precheck.sh 会扫描所有 "CHANGE_ME_*" 占位符，必须全部替换为真实值。
# ══════════════════════════════════════════════════════════

# ── Compose ──
COMPOSE_PROJECT_NAME=open436-prod

# ── Admin 独立容器 LAN 绑定（实验室网卡）──
# 仅此一个端口发布到宿主机；启动前用 scripts/precheck.sh 检测 IP 是否已挂载。
# 严禁填 0.0.0.0（precheck 会拒绝）。
ADMIN_BIND_IP=172.20.193.162
ADMIN_BIND_PORT=3001

# ── PostgreSQL（open436 业务库 + ai_db）──
POSTGRES_USER=open436
# 会嵌入 DATABASE_URL；使用 URL 安全字符，推荐：openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
POSTGRES_DB=open436

# ── Redis ──
# 会嵌入 REDIS_URL；使用 URL 安全字符，推荐：openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── MinIO ──
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=open436-posts

# ── MySQL（HOJ）──
HOJ_MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_HOJ_MYSQL_PASSWORD

# ── Nacos（HOJ 服务注册/配置中心）──
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME_STRONG_NACOS_PASSWORD

# ── 应用密钥 ──
# Forum Django SECRET_KEY（必须更换，长度 ≥ 50）
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_50_CHARS
# Auth/Forum/FileService 内部服务间密钥
INTERNAL_API_KEY=CHANGE_ME_STRONG_INTERNAL_KEY

# ── 阶段6 连接池/线程预算（默认值见 application-prod.yml，按需覆盖）──
# Auth:    Hikari 20 / Tomcat 120
# Enrollment: Hikari 15 / Tomcat 80
# PostgreSQL 总预算：20+15+Forum16+File20+AI30 ≈ 101 / max_connections=150
#AUTH_TOMCAT_MAX_THREADS=120
#AUTH_HIKARI_MAX_POOL=20
#AUTH_HIKARI_MIN_IDLE=5
#ENROLLMENT_TOMCAT_MAX_THREADS=80
#ENROLLMENT_HIKARI_MAX_POOL=15
#ENROLLMENT_HIKARI_MIN_IDLE=5
# HOJ 与 Auth 同步的 API key
HOJ_API_KEY=CHANGE_ME_STRONG_HOJ_API_KEY
# HOJ 浏览器登录 JWT 签名密钥（与 API key / 判题 token 分离）
HOJ_JWT_SECRET=CHANGE_ME_RANDOM_HOJ_JWT_SECRET
# ── HOJ 必填 ──
# 判题机与后端共享密钥（防外部穷举 default），长随机
JUDGE_TOKEN=CHANGE_ME_RANDOM_JUDGE_TOKEN

# ── HOJ 管理账号（用于 Auth↔HOJ 同步）──
HOJ_ADMIN_USER=CHANGE_ME_HOJ_ADMIN_USER
HOJ_ADMIN_PASS=CHANGE_ME_STRONG_HOJ_ADMIN_PASS

# ── 生产 Auth 管理员初始化（必填，清理 V2/V10 默认账号后创建）──
#   username：生产管理员登录名（不要用 admin/test，那是 Flyway 默认名会被拒绝）
#   password-hash：BCrypt cost=10 哈希（绝不可填明文）
#   生成示例：htpasswd -bnBC 10 "" "YourStrongPass" | tr -d ':\n'
#   ─────────────── 关键：必须用单引号包裹 ───────────────
#   Docker Compose 会对未加引号和双引号值执行变量插值；单引号值按字面量处理。
#   因此 BCrypt 的 $ 必须单引号包裹，避免 Compose 把哈希片段误读为变量引用。
#   写入预填示例值时也要带单引号。
ADMIN_BOOTSTRAP_USER=CHANGE_ME_ADMIN_USERNAME
ADMIN_BOOTSTRAP_PASSWORD_HASH='$2b$10$EXAMPLE_BCRYPT_HASH_NEVER_PLAINTEXT_paste_real_here'

# ── AI 服务 ──
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
TAVILY_API_KEY=

# ── CORS（直连 Admin LAN）──
# public-web 会清除同源 API 的 Origin，因此 Quick Tunnel 随机域名无需写入这里。
CORS_ALLOWED_ORIGINS=http://172.20.193.162:3001

# ── Milvus ──
# 无需单独配置：Milvus 复用上面的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 凭据，
# bucket（open436-milvus）由 minio-init 服务幂等创建。
